# DuoLingo MCP Server Configuration
# -----------------------------------
#
# SECRETS MANAGEMENT
# ==================
# This file is used for non-secret settings (enforcement window, server
# host/port) AND as a fallback for secrets during local development.
#
# In production, use Docker Swarm secrets instead of putting real values here:
#   1. Initialize Swarm (one-time):  docker swarm init
#   2. Create secrets:               ./setup-secrets.sh
#   3. Deploy:                        docker stack deploy -c docker-compose.swarm.yml duolingo
#
# When Swarm secrets exist at /run/secrets/<name>, they override the values
# below. See server.py load_config() for the resolution logic.
#
# Copy this to config.yaml and fill in your values.
# Get your JWT token from browser cookies at duolingo.com
# (Application tab → Cookies → jwt_token)

duolingo:
  # These are overridden by Docker Swarm secrets in production:
  #   /run/secrets/duolingo_jwt      -> jwt_token
  #   /run/secrets/duolingo_username -> username
  jwt_token: "PASTE_YOUR_JWT_HERE"
  username: "PASTE_YOUR_USERNAME_HERE"

enforcement:
  # Time window when enforcement kicks in (24h format)
  start_hour: 20  # 8 PM
  end_hour: 23    # 11 PM
  # Minutes between alert level escalations
  escalation_interval_minutes: 10

server:
  host: "0.0.0.0"
  port: 8000
  # Overridden by /run/secrets/duolingo_api_key in production.
  # Clients must send "Authorization: Bearer <api_key>" to connect.
  # Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
  # Leave blank or omit to disable auth (local dev only).
  api_key: ""
